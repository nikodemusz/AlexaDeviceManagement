{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent Alexa Native Skill Configuration v6",
  "type": "object",
  "required": [
    "schema_version",
    "enabled",
    "locale",
    "devices"
  ],
  "properties": {
    "schema_version": {
      "const": 6
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "devices": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/device"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "device": {
      "type": "object",
      "required": [
        "name",
        "capabilities"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "display_category": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ha_device_id": {
          "type": "string",
          "minLength": 1
        },
        "group_mode": {
          "enum": [
            "combined",
            "separate"
          ]
        },
        "members": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[A-Za-z0-9_]+$"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "group_mode": {
                "const": "combined"
              }
            },
            "required": [
              "group_mode"
            ]
          },
          "then": {
            "required": [
              "ha_device_id",
              "members"
            ],
            "properties": {
              "members": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "group_mode": {
                  "const": "combined"
                }
              },
              "required": [
                "group_mode"
              ]
            }
          },
          "then": {
            "properties": {
              "members": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": [
        "interface",
        "entity_id"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "interface": {
          "enum": [
            "Alexa.PowerController",
            "Alexa.BrightnessController",
            "Alexa.RangeController",
            "Alexa.ToggleController",
            "Alexa.PlaybackController",
            "Alexa.ContactSensor",
            "Alexa.MotionSensor",
            "Alexa.TemperatureSensor",
            "Alexa.ThermostatController"
          ]
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[a-z_]+\\.[A-Za-z0-9_]+$"
        },
        "instance": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "read_only": {
          "type": "boolean"
        },
        "supported_operations": {
          "type": "array",
          "const": [
            "Stop"
          ]
        },
        "capability_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "interface": {
                "enum": [
                  "Alexa.RangeController",
                  "Alexa.ToggleController"
                ]
              }
            },
            "required": [
              "interface"
            ]
          },
          "then": {
            "required": [
              "instance"
            ]
          },
          "else": {
            "not": {
              "required": [
                "instance"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "interface": {
                "const": "Alexa.RangeController"
              }
            },
            "required": [
              "interface"
            ]
          },
          "then": {
            "required": [
              "unit"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "interface": {
                "const": "Alexa.RangeController"
              },
              "read_only": {
                "const": false
              }
            },
            "required": [
              "interface",
              "read_only"
            ]
          },
          "then": {
            "properties": {
              "entity_id": {
                "pattern": "^cover\\."
              },
              "instance": {
                "const": "cover.position"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "interface": {
                "const": "Alexa.PlaybackController"
              }
            },
            "required": [
              "interface"
            ]
          },
          "then": {
            "properties": {
              "entity_id": {
                "pattern": "^cover\\."
              },
              "supported_operations": {
                "const": [
                  "Stop"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "interface": {
                "const": "Alexa.ThermostatController"
              }
            },
            "required": [
              "interface"
            ]
          },
          "then": {
            "properties": {
              "supported_modes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "HEAT",
                    "COOL",
                    "AUTO",
                    "OFF",
                    "ECO"
                  ]
                },
                "contains": {
                  "enum": [
                    "HEAT",
                    "COOL"
                  ]
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
